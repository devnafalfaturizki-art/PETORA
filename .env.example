# Petora Environment Configuration
# Copy this file to .env and fill in the values

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_APP_NAME=Petora
VITE_APP_VERSION=1.0.0
VITE_ENABLE_WHATSAPP_NOTIFICATIONS=false
VITE_ENABLE_EMAIL_NOTIFICATIONS=false
VITE_DEFAULT_TIMEZONE=Asia/Jakarta
VITE_CURRENCY=IDR
VITE_LOYALTY_POINT_VALUE=100
VITE_LOW_STOCK_THRESHOLD=5